{
  "name": "pricetruth",
  "version": "1.0.0",
  "description": "PriceTruth — the actual price of anything online. True-cost breakdowns, price history, and deal quality scores.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "build": "node src/build.js",
    "build:netlify": "npm run check && npm run build && node scripts/build-netlify.mjs",
    "seed": "node src/seed.js",
    "keygen": "node src/keygen.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check-source.mjs && node scripts/validate-openapi.mjs && node scripts/validate-extension.mjs",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "test:browser": "playwright test",
    "smoke:security": "node scripts/security-smoke.mjs",
    "smoke:performance": "node scripts/performance-smoke.mjs",
    "launch:gate": "node scripts/launch-gate.mjs",
    "deploy:verify": "node scripts/postdeploy-check.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:cutover": "node scripts/migrate-sqlite-to-netlify.mjs",
    "extension:icons": "node scripts/generate-extension-icons.mjs",
    "extension:check": "node scripts/validate-extension.mjs && node --test test/extension-adapters.test.js test/extension-package.test.js test/extzip.test.js",
    "extension:package": "node scripts/package-extension.mjs",
    "api:check": "node scripts/validate-openapi.mjs"
  },
  "dependencies": {
    "@netlify/database": "^2.0.0",
    "@netlify/functions": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@netlify/database-dev": "^1.0.0",
    "@playwright/test": "1.62.1"
  }
}
