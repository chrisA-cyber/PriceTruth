# Copy to deploy/local.env for local container use. Never commit local.env.
PUBLIC_BASE_URL=http://localhost:4780
EMAIL_TRANSPORT=console
ADMIN_TOKEN=
DISABLE_WORKER=0
REQUIRE_EMAIL=0
ENABLE_ACCOUNTS=0
ENABLE_LIVE_BILLING=0
ENABLE_DEMO_SEED=1
LAUNCH_VERTICALS=hotel,flight,ticket,subscription,retail
ENABLE_AFFILIATE_LINKS=0
AFFILIATE_RELATIONSHIPS_APPROVED=0
SUBSCRIPTION_CATALOG_MAX_AGE_DAYS=93
