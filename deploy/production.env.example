# Values are intentionally empty: inject them from the deployment secret store.
# Run: npm run launch:gate -- --env-file deploy/production.env
NODE_ENV=production
HOST=0.0.0.0
PORT=4780
PUBLIC_BASE_URL=
PRICETRUTH_DB=/var/lib/pricetruth/pricetruth.db
TRUST_PROXY=1
ADMIN_TOKEN=
LEGAL_OPERATOR_NAME=
LEGAL_JURISDICTION=
SUPPORT_CONTACT_URL=
SUPPORT_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=
LEGAL_APPROVED=0
LEGAL_TERMS_VERSION=
SESSION_TTL_DAYS=30
DISABLE_WORKER=0
REQUIRE_EMAIL=1

EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=
OUTBOX_ENCRYPTION_KEY=
RESEND_WEBHOOK_SECRET=

ENABLE_LIVE_BILLING=1
STRIPE_AUTOMATIC_TAX=1
ENABLE_ACCOUNTS=1
ENABLE_DEMO_SEED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_API_STARTER=
STRIPE_PRICE_API_PRO=
STRIPE_PRODUCT_PREMIUM=
STRIPE_PRODUCT_API_STARTER=
STRIPE_PRODUCT_API_PRO=

TICKETMASTER_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=https://api.amadeus.com
RETAIL_API_URL=
RETAIL_API_KEY=

# Fail-closed by default. Enable only after legal approval, a public disclosure,
# and real agreement-specific tags are stored as secrets.
ENABLE_AFFILIATE_LINKS=0
AFFILIATE_RELATIONSHIPS_APPROVED=0
AFFILIATE_DISCLOSURE_URL=
# AFFILIATE_TAG_BOOKING=
# AFFILIATE_TAG_EXPEDIA=

# Comma-separated verticals publicly promised at launch. Hotel/flight require
# production Amadeus credentials; retail requires an HTTPS authenticated feed.
# Ticket is intentionally rejected until a source attests all-in checkout price.
LAUNCH_VERTICALS=subscription
# Oldest verified subscription row must remain within this window (1..365).
SUBSCRIPTION_CATALOG_MAX_AGE_DAYS=93

# Bounded request/provider I/O. Defaults are shown; tune only with load evidence.
JSON_BODY_TIMEOUT_MS=10000
PROVIDER_RESPONSE_LIMIT_BYTES=1048576
WEBHOOK_BODY_TIMEOUT_MS=10000
STRIPE_WEBHOOK_BODY_LIMIT_BYTES=262144
EMAIL_WEBHOOK_BODY_LIMIT_BYTES=131072
WEBHOOK_MAX_CONCURRENCY=8
WEBHOOK_PREAUTH_MAX_CONCURRENCY_PER_IP=2
WEBHOOK_PREAUTH_BURST=30
WEBHOOK_PREAUTH_REFILL_PER_SECOND=1
WEBHOOK_BURST=100
WEBHOOK_REFILL_PER_SECOND=5
