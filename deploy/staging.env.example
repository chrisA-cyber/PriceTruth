# Safe production-mode staging baseline. It does not charge, send customer
# email, or expose account surfaces. Amadeus sandbox credentials must not be
# attached to this public runtime; exercise them only in an isolated provider
# harness because sandbox inventory is not a verified public price. Stripe test secrets are intentionally unsupported
# by the paid-launch runtime; billing lifecycle fixtures run in CI, and an
# authorized low-value live verification remains a paid-beta release gate.
NODE_ENV=production
HOST=0.0.0.0
PORT=4780
# Replace the reserved placeholder before startup.
PUBLIC_BASE_URL=https://staging.example.invalid
PRICETRUTH_DB=/var/lib/pricetruth/pricetruth.db
TRUST_PROXY=1
ADMIN_TOKEN=
SESSION_TTL_DAYS=30
DISABLE_WORKER=0
REQUIRE_EMAIL=0
ENABLE_ACCOUNTS=0
ENABLE_DEMO_SEED=0

EMAIL_TRANSPORT=
RESEND_API_KEY=
EMAIL_FROM=
OUTBOX_ENCRYPTION_KEY=
RESEND_WEBHOOK_SECRET=

ENABLE_LIVE_BILLING=0
STRIPE_AUTOMATIC_TAX=0

TICKETMASTER_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Leave unset on ordinary staging. A reviewed production-inventory canary must
# set the exact origin https://api.amadeus.com together with production keys.
AMADEUS_HOST=
RETAIL_API_URL=
RETAIL_API_KEY=

ENABLE_AFFILIATE_LINKS=0
AFFILIATE_RELATIONSHIPS_APPROVED=0
AFFILIATE_DISCLOSURE_URL=

LAUNCH_VERTICALS=subscription
SUBSCRIPTION_CATALOG_MAX_AGE_DAYS=93

JSON_BODY_TIMEOUT_MS=10000
PROVIDER_RESPONSE_LIMIT_BYTES=1048576
WEBHOOK_BODY_TIMEOUT_MS=10000
STRIPE_WEBHOOK_BODY_LIMIT_BYTES=262144
EMAIL_WEBHOOK_BODY_LIMIT_BYTES=131072
WEBHOOK_MAX_CONCURRENCY=8
WEBHOOK_PREAUTH_MAX_CONCURRENCY_PER_IP=2
