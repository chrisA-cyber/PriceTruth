# Native Netlify production values. Copy this file outside the repository,
# fill every blank, then import it with the Netlify CLI or enter values in
# Project configuration -> Environment variables. Never commit real values.
#
# Netlify supplies URL, SITE_ID, SITE_NAME, and NETLIFY_DB_URL. Do not add them.
# PUBLIC_BASE_URL is optional; published production uses the Netlify main site
# URL by default, while previews always stay on their current deploy origin.
# Set it only for a reviewed final production custom-domain override.

NODE_ENV=production
AWS_LAMBDA_JS_RUNTIME=nodejs24.x
DATABASE_MODE=netlify
WORKER_MODE=netlify-background
ENABLE_DEMO_SEED=0
ENABLE_ACCOUNTS=1
REQUIRE_EMAIL=1
EMAIL_TRANSPORT=resend
DISABLE_WORKER=0
# Generate a unique value with at least 32 random characters. The one-minute
# scheduler signs every private background-worker dispatch with this secret.
WORKER_DISPATCH_SECRET=
ENABLE_LIVE_BILLING=0
LAUNCH_VERTICALS=subscription
SUBSCRIPTION_CATALOG_MAX_AGE_DAYS=93

# Optional canonical override:
# PUBLIC_BASE_URL=https://pricetruth.example

ADMIN_TOKEN=
OUTBOX_ENCRYPTION_KEY=
# Optional separate key for pending B2B key claims. Existing installations
# must preserve the exact prior value during SQLite cutover; when unset it
# intentionally falls back to OUTBOX_ENCRYPTION_KEY.
# PENDING_KEY_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

LEGAL_OPERATOR_NAME=
LEGAL_JURISDICTION=
SUPPORT_CONTACT_URL=
SUPPORT_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=
LEGAL_TERMS_VERSION=
LEGAL_APPROVED=0

# Keep ENABLE_LIVE_BILLING=0 until the database, worker, email, legal, catalog,
# and webhook gates pass. Then populate these live values and flip it to 1 in
# one reviewed promotion.
STRIPE_AUTOMATIC_TAX=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_API_STARTER=
STRIPE_PRICE_API_PRO=
STRIPE_PRODUCT_PREMIUM=
STRIPE_PRODUCT_API_STARTER=
STRIPE_PRODUCT_API_PRO=

# Optional verified production price providers. Never use Amadeus test hosts
# for a production truth claim.
TICKETMASTER_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=https://api.amadeus.com
# Public HTTPS endpoint; paths/query parameters are allowed, credentials and fragments are not.
# Redirect responses are rejected so RETAIL_API_KEY is never forwarded to another endpoint.
RETAIL_API_URL=
RETAIL_API_KEY=

ENABLE_AFFILIATE_LINKS=0
AFFILIATE_RELATIONSHIPS_APPROVED=0
AFFILIATE_DISCLOSURE_URL=
# AFFILIATE_TAG_BOOKING=
# AFFILIATE_TAG_EXPEDIA=

JSON_BODY_TIMEOUT_MS=10000
PROVIDER_RESPONSE_LIMIT_BYTES=1048576
WEBHOOK_BODY_TIMEOUT_MS=10000
STRIPE_WEBHOOK_BODY_LIMIT_BYTES=262144
EMAIL_WEBHOOK_BODY_LIMIT_BYTES=131072
